# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://ascend_user:ascend_password@localhost:5432/ascend_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_MAX_LIFETIME=30m

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# AWS Configuration (for S3 video storage)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ascend-videos-eu-west-1
AWS_CLOUDFRONT_DOMAIN=

# JWT Configuration
JWT_ACCESS_SECRET=change-this-to-a-strong-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-strong-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Monitoring (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics (PostHog - EU instance)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# Feature Flags
ENABLE_VIDEO_PROCESSING=true
ENABLE_ANALYTICS=true
