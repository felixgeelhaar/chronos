# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ascend
DB_PASSWORD=ascend_dev_password
DB_NAME=ascend
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=8080
ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRATION=24h

# Video Storage
VIDEO_STORAGE_PATH=./storage/videos
MAX_VIDEO_SIZE_MB=100
ALLOWED_VIDEO_FORMATS=mp4,mov,avi

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Video Analysis (if applicable)
VIDEO_ANALYSIS_ENDPOINT=http://localhost:5000
VIDEO_ANALYSIS_TIMEOUT=30s

# S3/MinIO (if using object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ascend
S3_SECRET_KEY=ascend_minio_password
S3_BUCKET=ascend-videos
S3_REGION=us-east-1
S3_USE_SSL=false
