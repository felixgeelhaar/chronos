{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Chronos Service Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Signals Emitted /sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(chronos_signals_emitted_total[5m]))", "legendFormat": "all patterns" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 }
    },
    {
      "title": "Observations Ingested /sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(chronos_observations_total[5m]))", "legendFormat": "all adapters" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 }
    },
    {
      "title": "HTTP Requests /sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(chronos_http_requests_total[5m]))", "legendFormat": "all" }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 }
    },
    {
      "title": "5xx Error Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(chronos_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(chronos_http_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 }
    },
    {
      "title": "Detector Output (rate by pattern)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (pattern) (rate(chronos_signals_emitted_total[5m]))",
          "legendFormat": "{{pattern}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "title": "HTTP p50/p95/p99 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(chronos_http_request_duration_seconds_sum[5m]) / rate(chronos_http_request_duration_seconds_count[5m])",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    },
    {
      "title": "HTTP Status Mix",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(chronos_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }
    },
    {
      "title": "Webhook Deliveries by Status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(chronos_webhook_deliveries_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }
    },
    {
      "title": "Observations by Adapter",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (adapter) (rate(chronos_observations_total[5m]))",
          "legendFormat": "{{adapter}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["chronos", "cognitive-stack"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
